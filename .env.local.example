# Deployed contract address on Sepolia testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Sepolia chain ID (do not change)
NEXT_PUBLIC_CHAIN_ID=11155111

# Sepolia RPC URL (optional but recommended for reliability)
# Get a free endpoint at https://infura.io, https://alchemy.com, or https://app.quicknode.com
# If omitted, the app falls back to public RPC endpoints.
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
